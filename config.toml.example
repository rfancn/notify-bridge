[sdk.log]
    level = "info"
    filename = "notify-bridge.log"
    dir = "logs"
    [sdk.log.rotate]
        max_age = 168
        max_backup = 5
        max_size = 100

[app]
    # 服务监听地址，可被 --app-address 覆盖
    listen = ":8080"
    # 必填：禅道 webhook 请求必须携带的共享密钥
    # 支持 Authorization: Bearer <token> 或 X-Webhook-Token: <token>
    token = ""

    [app.routes.zentao-mattermost-notify]
            [app.routes.zentao-mattermost-notify.source]
                type = "zentao"
                url = "http://zentao"
                account = "YOUR_ZENTAO_ACCOUNT"
                password = "YOUR_ZENTAO_PASSWORD"

            [app.routes.zentao-mattermost-notify.target]
                type = "mattermost"
                url = "http://mattermost"
                # 机器人访问令牌
                token = "YOUR_MATTERMOST_BOT_TOKEN"
                # 机器人用户名
                bot_user = "YOUR_MATTERMOST_BOT_USER"

